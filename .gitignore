# Configuração e segredos — por instância, nunca versionados
.env

# Banco — gerado por database/migrate.php
database/*.sqlite
database/*.sqlite-shm
database/*.sqlite-wal

# Uploads — por instância
public_html/assets/uploads/*
!public_html/assets/uploads/.gitkeep

# Locks do worker E os arquivos recebidos nas conversas.
#
# Fica fora do versionamento por duas razões, e a segunda é a séria: é por
# instância, e é DADO PESSOAL — a foto que alguém mandou, o áudio que gravou.
# Um `git push` distraído publicaria isso num repositório.
storage/
*.lock
*.log

# vendor/ NÃO entra aqui: é commitado de propósito, para que o deploy
# continue sendo apenas `git pull`, sem build. Ver ARQUITETURA.md §1.

# Sistema operacional / editores
Thumbs.db
desktop.ini
.DS_Store
.idea/
.vscode/
*.code-workspace
