APP_ENV=production
APP_NOME=simpleAIman
# APP_URL nao e so cosmetico: e por ela que o upload dispara o worker
# (api/worker-kick.php). Apontando para um endereco que nao resolve, o kick
# falha em silencio e o arquivo fica "pendente" ate o cron rodar — ou para
# sempre, se nao houver cron. O painel avisa quando isso acontece.
APP_URL=https://assistente.cliente.com.br
APP_TIMEZONE=America/Sao_Paulo

DB_PATH=../database/simpleaiman.sqlite
# Sem busy_timeout, escritor concorrente recebe SQLITE_BUSY na hora em vez de
# esperar — origem de quase todo "database is locked". Nunca zere isto.
DB_BUSY_TIMEOUT_MS=5000

SESSION_SECRET=troque-esta-chave-por-uma-string-aleatoria-longa
SESSION_NAME=simpleaiman_sess
LOGIN_MAX_TENTATIVAS=5
LOGIN_BLOQUEIO_MINUTOS=15

# ---------------------------------------------------------------------
# Chaves dos provedores de LLM
#
# A tabela `provedores` guarda apenas o NOME da variável (auth_ref), nunca a
# chave. Chave no banco vazaria em backup e em log.
# ---------------------------------------------------------------------
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# ---------------------------------------------------------------------
# Ingestão / worker
# ---------------------------------------------------------------------
UPLOAD_MAX_MB=20
# Quantos chunks por execução do worker. O worker é retomável: processa um
# lote, grava o progresso e sai limpo antes do max_execution_time.
WORKER_LOTE=25
WORKER_TEMPO_MAX_S=20
# Token do endpoint api/worker-kick.php (dispara o worker logo após um upload,
# sem esperar o cron). Gere um valor aleatório longo.
WORKER_TOKEN=

# ---------------------------------------------------------------------
# Relogios do atendimento humano (minutos; 0 desliga a regra)
# ---------------------------------------------------------------------
# Espera na fila antes de o assistente retomar
ESPERA_MAX_MIN=5
# Visitante calado numa conversa em atendimento: avisa o atendente, depois encerra
INATIVIDADE_AVISO_MIN=10
INATIVIDADE_HUMANO_MIN=30
# Conversa so com o assistente, parada: encerra em silencio
INATIVIDADE_BOT_MIN=60
# Presenca do atendente: segundos sem batimento ate sumir da fila
PRESENCA_JANELA_SEG=120
# Minutos ate devolver a fila uma conversa presa com quem sumiu
PRESENCA_ORFA_MIN=3

# ---------------------------------------------------------------------
# Guarda da camada de ferramentas HTTP
#
# Uma ferramenta HTTP configurável é, na prática, um cliente HTTP exposto a
# quem conversa com o bot. A allowlist fica AQUI e nunca como campo editável
# no admin. Hosts separados por vírgula; vazio bloqueia toda chamada externa.
# ---------------------------------------------------------------------
TOOLS_HOSTS_PERMITIDOS=
TOOLS_TIMEOUT_MS=8000
TOOLS_RESPOSTA_MAX_KB=64

# ---------------------------------------------------------------------
# E-mail (chamados do handoff Nível 1 + recuperação de senha do admin)
# MAIL_DRIVER=mail -> função mail() nativa
# MAIL_DRIVER=smtp -> servidor SMTP autenticado
# ---------------------------------------------------------------------
MAIL_DRIVER=mail
MAIL_FROM=nao-responda@cliente.com.br
MAIL_FROM_NOME=Assistente
MAIL_SMTP_HOST=
MAIL_SMTP_PORT=587
MAIL_SMTP_USUARIO=
MAIL_SMTP_SENHA=
MAIL_SMTP_SEGURANCA=tls
