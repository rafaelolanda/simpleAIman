# Normaliza fim de linha: LF no repositório, sempre.
# O deploy é em Linux (hospedagem compartilhada); CRLF vazando para lá quebra
# shebang de script e comparação de arquivo.
* text=auto eol=lf

# Binários — nunca converter
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.ico binary
*.gif binary
*.pdf binary
*.woff binary
*.woff2 binary
*.sqlite binary
